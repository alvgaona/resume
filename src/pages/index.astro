---
import Layout from "@/layouts/Layout.astro";
import ResumeView from "@/components/resume-view.astro";
import { data } from "@/i18n/en/resume-data";
import { ui } from "@/i18n/ui";

const labels = ui.en;
---

<Layout meta={{ title: labels["meta.title"] }}>
  <ResumeView data={data} labels={labels} showProjects={false} />
</Layout>
